{
	"name": "format-ext",
	"displayName": "FormatExt",
	"description": "Custom formatter support. Use prettier, clang-format or whatever else you have in your PATH without their VS Code extensions.",
	"version": "0.1.0",
	"publisher": "1hue",
	"author": {
		"name": "1hue",
		"url": "https://1hue.dev"
	},
	"license": "MIT",
	"icon": "assets/icon.png",
	"galleryBanner": {
		"color": "#13141C",
		"theme": "dark"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/1hue/format-ext-vscode"
	},
	"engines": {
		"vscode": "^1.82.0"
	},
	"categories": [
		"Formatters"
	],
	"main": "./out/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "Formatting is off in Restricted Mode."
		}
	},
	"contributes": {
		"configuration": {
			"title": "FormatExt",
			"properties": {
				"formatExt.formatters": {
					"markdownDescription": "Commands or paths that read stdin and write stdout, mapped to the target file endings.\n\n`${file}` is replaced with the filepath.\n\nFor example: `\"prettier --stdin-filepath ${file}\": \".js,.ts\"`",
					"type": "object",
					"default": {
						"clang-format --assume-filename=${file}": ".c,.h,.cc,.cp,.cpp,.cxx,.c++,.hh,.hpp,.hxx,.h++,.ipp,.inl,.tpp,.ixx,.cppm,.ccm,.cxxm,.c++m,.m,.mm,.cu,.cuh,.glsl,.vert,.frag,.geom,.comp,.tesc,.tese,.hlsl,.hlsli,.metal,.gdshader,.gdshaderinc,.java,.cs,.proto,.protodevel,.td,.textproto,.textpb,.txtpb,.asciipb,.sv,.svh,.vh",
						"prettier --stdin-filepath ${file}": ".js,.cjs,.mjs,.jsx,.ts,.cts,.mts,.tsx,.json,.jsonc,.json5,.css,.scss,.less,.html,.htm,.vue,.md,.markdown,.mdx,.yaml,.yml,.graphql,.gql,.hbs,.handlebars"
					},
					"propertyNames": {
						"pattern": "\\$\\{file\\}",
						"patternErrorMessage": "Pass the file path as ${file}"
					},
					"additionalProperties": {
						"type": "string",
						"pattern": "^([^\\s,]+(,\\s*[^\\s,]+)*)?$",
						"patternErrorMessage": "Comma-separated file endings like .c,.h"
					}
				}
			}
		}
	},
	"scripts": {
		"compile": "tsc -p .",
		"prepackage": "npm audit --audit-level=moderate && npm run compile",
		"package": "mkdir -p build && vsce package --out build/"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@types/vscode": "~1.82.0",
		"@vscode/vsce": "^4.1.0",
		"prettier": "3.9.10",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"@azure/msal-node": "^7.2.0",
		"minimatch": "^11.0.4"
	}
}
