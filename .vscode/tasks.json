{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "make build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$tsc"
		},
		{
			"label": "install",
			"type": "shell",
			"command": "make install",
			"group": "build",
			"problemMatcher": "$tsc"
		},
		{
			"label": "compile",
			"type": "shell",
			"command": "make compile",
			"hide": true,
			"problemMatcher": "$tsc"
		}
	]
}
